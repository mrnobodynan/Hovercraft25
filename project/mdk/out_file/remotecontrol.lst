  199          float IncPIDCalc(float CurrentPoint,float SetPoint,struct PID* sptr) 
  200          {
  201   1        float iIncpid;
  202   1        sptr->iError=SetPoint-CurrentPoint;                                     // 计算当前误差
  203   1        iIncpid=sptr->Proportion * (sptr->iError-sptr->Error1)                  // P
  204   1                      +sptr->Integral * sptr->iError                                   // I
  205   1                      +sptr->Derivative * (sptr->iError-2*sptr->Error1+sptr->Error2);  // D             
  206   1        sptr->Error2=sptr->Error1;                          // 存储误差，用于下次计算
  207   1        sptr->Error1=sptr->iError;                        
  208   1        return(iIncpid);                                    // 返回增量值
  209   1      }
